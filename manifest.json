{
  "manifest_version": 3,
  "name": "Sort by Ratings - Flipkart, Myntra & Amazon",
  "version": "21.0.0",
  "description": "Sort products by most ratings on Flipkart, Myntra & Amazon. Scan unlimited pages with anti-block fallback (multi-tab + infinite scroll).",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "*://*.flipkart.com/*",
    "*://*.myntra.com/*",
    "*://*.amazon.in/*",
    "*://*.amazon.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.flipkart.com/*",
        "*://flipkart.com/*",
        "*://www.myntra.com/*",
        "*://myntra.com/*",
        "*://www.amazon.in/*",
        "*://amazon.in/*",
        "*://www.amazon.com/*",
        "*://amazon.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
