{
  "manifest_version": 3,
  "name": "Flipkart + Myntra Sort by Ratings",
  "version": "19.0.0",
  "description": "Sort search results by ratings count across pages. AD/Sponsored last.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.flipkart.com/*",
        "https://flipkart.com/*",
        "https://www.myntra.com/*",
        "https://myntra.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
