{
  "manifest_version": 3,
  "name": "Flipkart + Myntra Sort by Ratings",
  "version": "13.0.0",
  "description": "Sort Flipkart & Myntra results by ratings count. Sponsored/AD products at the end.",
  "content_scripts": [
    {
      "matches": [
        "https://www.flipkart.com/*",
        "https://flipkart.com/*",
        "https://www.myntra.com/*",
        "https://myntra.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
